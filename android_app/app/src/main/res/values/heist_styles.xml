<resources>
    <style name="Widget.Heist.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/heist_button_primary</item>
        <item name="android:textColor">@color/heist_button_text</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>
    <style name="Widget.Heist.Button.Secondary" parent="Widget.Heist.Button.Primary">
        <item name="backgroundTint">@color/heist_button_secondary</item>
        <item name="strokeColor">@color/heist_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.Heist.Button.Danger" parent="Widget.Heist.Button.Secondary">
        <item name="android:textColor">@color/heist_alarm</item>
        <item name="strokeColor">@color/heist_alarm</item>
    </style>
    <style name="Widget.Heist.Button.Drive" parent="Widget.Heist.Button.Secondary">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="TextAppearance.Heist.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/heist_text</item>
    </style>
    <style name="TextAppearance.Heist.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/heist_text</item>
    </style>
    <style name="TextAppearance.Heist.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/heist_text_secondary</item>
    </style>
    <style name="TextAppearance.Heist.Telemetry" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/heist_text_secondary</item>
    </style>
</resources>
