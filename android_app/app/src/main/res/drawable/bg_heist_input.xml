<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/status_bg" />
            <stroke android:width="2dp" android:color="@color/heist_blue" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/status_bg" />
            <stroke android:width="1dp" android:color="@color/heist_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>