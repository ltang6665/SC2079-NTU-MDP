<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#4A0000" />
                </shape>
            </item>

            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="oval">
                    <solid android:color="#7A0000" />
                </shape>
            </item>

            <item android:top="4dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="oval">
                    <solid android:color="#B71C1C" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#3B0000" />
                </shape>
            </item>

            <item android:top="4dp" android:bottom="0dp">
                <shape android:shape="oval">
                    <solid android:color="#800000" />
                </shape>
            </item>

            <item android:bottom="10dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="oval">
                    <solid android:color="#E53935" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>