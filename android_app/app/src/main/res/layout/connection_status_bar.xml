<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/connectionContainer"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="36dp" android:background="@color/heist_surface"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingHorizontal="16dp" android:paddingVertical="8dp">
    <ImageView android:id="@+id/statusDot"
        android:layout_width="8dp" android:layout_height="8dp"
        android:layout_marginEnd="10dp" android:importantForAccessibility="no"
        android:src="@drawable/bg_status_dot" />
    <TextView android:id="@+id/connectionBadge"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:text="@string/status_disconnected" android:textColor="@color/heist_text"
        android:textSize="13sp" android:accessibilityLiveRegion="polite" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:text="@string/heist_group"
        android:fontFamily="sans-serif-condensed" android:textStyle="bold"
        android:textColor="@color/heist_text_secondary" android:textSize="13sp" />
</LinearLayout>