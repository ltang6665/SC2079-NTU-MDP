<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/heist_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/title" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="2dp"
            android:accessibilityHeading="true" android:text="@string/comms_title"
            android:textAppearance="@style/TextAppearance.Heist.Title" />
    </LinearLayout>

    <!-- Main Top Panel (Weight 3) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="3"
        android:layout_marginTop="6dp" android:background="@drawable/bg_heist_panel"
        android:orientation="vertical" android:padding="4dp">

        <TextView android:id="@+id/statusView" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/status_disconnected"
            android:textAppearance="@style/TextAppearance.Heist.Telemetry"
            android:textColor="@color/heist_text_secondary" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="8dp">

            <Button
                android:id="@+id/btnScan"
                style="@style/Widget.Heist.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/comms_scan"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <Button
                android:id="@+id/btnDisconnect"
                style="@style/Widget.Heist.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@string/btn_disconnect"
                app:layout_constraintTop_toTopOf="@id/btnScan"
                app:layout_constraintStart_toEndOf="@id/btnScan" />

            <Button
                android:id="@+id/btnStopConnection"
                style="@style/Widget.Heist.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@string/comms_stop_connection"
                app:layout_constraintTop_toTopOf="@id/btnDisconnect"
                app:layout_constraintStart_toEndOf="@id/btnDisconnect" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Vertical Lists Wrapper -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp" android:layout_marginTop="4dp" android:orientation="vertical">

            <!-- Paired Devices -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/labelPaired" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:accessibilityHeading="true" android:text="@string/hint_paired_devices"
                        android:textAppearance="@style/TextAppearance.Heist.Section" />
                    <TextView android:id="@+id/pairedCount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:background="@drawable/bg_heist_badge" android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp" android:textAppearance="@style/TextAppearance.Heist.Telemetry" />
                </LinearLayout>

                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp" android:background="@drawable/bg_heist_inset">
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/pairedList"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:clipToPadding="false" android:padding="2dp" android:scrollbars="vertical" />
                    <TextView android:id="@+id/pairedEmpty" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:gravity="center" android:padding="12dp"
                        android:text="@string/comms_paired_empty" android:textAppearance="@style/TextAppearance.Heist.Body" />
                </FrameLayout>
            </LinearLayout>

            <!-- Discovered Devices -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_marginTop="8dp" android:layout_weight="1" android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/labelDiscovered" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:accessibilityHeading="true" android:text="@string/comms_discovered"
                        android:textAppearance="@style/TextAppearance.Heist.Section" />
                    <TextView android:id="@+id/discoveredCount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:background="@drawable/bg_heist_badge" android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp" android:textAppearance="@style/TextAppearance.Heist.Telemetry" />
                </LinearLayout>

                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp" android:background="@drawable/bg_heist_inset">
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/discoveredList"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:clipToPadding="false" android:padding="2dp" android:scrollbars="vertical" />
                    <TextView android:id="@+id/discoveredEmpty" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:gravity="center" android:padding="12dp"
                        android:text="@string/comms_discovered_empty" android:textAppearance="@style/TextAppearance.Heist.Body" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Log Panel (Weight 2) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="2"
        android:layout_marginTop="6dp" android:background="@drawable/bg_heist_panel"
        android:orientation="vertical" android:padding="8dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/labelLog" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:accessibilityHeading="true"
                android:text="@string/comms_received" android:textAppearance="@style/TextAppearance.Heist.Section" android:textSize="12sp"/>
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp" android:background="@drawable/bg_heist_inset">
            <androidx.core.widget.NestedScrollView android:id="@+id/logScroll"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:fillViewport="true" android:scrollbars="vertical">
                <TextView android:id="@+id/inboundLog" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:padding="12dp"
                    android:textAppearance="@style/TextAppearance.Heist.Telemetry"
                    android:textColor="@color/heist_blue" android:textIsSelectable="true" />
            </androidx.core.widget.NestedScrollView>

            <TextView
                android:id="@+id/logEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="16dp"
                android:textAppearance="@style/TextAppearance.Heist.Body" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/sendRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/sendField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/comms_send_message"
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="52dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="12dp"
                android:textColor="@color/heist_text"
                android:textColorHint="@color/heist_text_secondary"
                android:textSize="14sp"
                android:backgroundTint="@color/heist_text_secondary" />

            <Button
                android:id="@+id/btnSend"
                style="@style/Widget.Heist.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="72dp"
                android:minHeight="52dp"
                android:text="@string/btn_send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>